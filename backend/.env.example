APP_NAME="Mini Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Часовой пояс расписания: в нём создаются слоты и отдаётся время в API.
APP_TIMEZONE=Europe/Moscow

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
